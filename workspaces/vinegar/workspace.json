{
  "description": "Ubuntu with the KDE desktop environment.",
  "docker_registry": "https://ghcr.io/",
  "image_src": "ubuntu.png",

  "name": "Ubuntu KDE Vinegar Studio",
  "friendly_name": "Ubuntu KDE + Vinegar Studio",

  "categories": [
    "Desktop"
  ],

  "architecture": [
    "amd64"
  ],

  "run_config": {
    "security_opt": [
      "seccomp=unconfined"
    ],
    "entrypoint": [
      "/kasminit"
    ],
    "user": 1000,
    "environment": {
      "HOME": "/home/kasm-user"
    }
  },

  "exec_config": {
    "first_launch": {
      "cmd": "bash -c 'apt update && apt install -y flatpak && flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo && flatpak install -y flathub org.vinegarhq.Vinegar'"
    },
    "go": {
      "cmd": "bash -c 'flatpak run org.vinegarhq.Vinegar studio'"
    },
    "assign": {
      "cmd": "bash -c 'flatpak run org.vinegarhq.Vinegar studio'"
    }
  },

  "compatibility": [
    {
      "version": "1.18.x",
      "image": "lscr.io/linuxserver/webtop:ubuntu-kde",
      "uncompressed_size_mb": 4000
    }
  ]
}
